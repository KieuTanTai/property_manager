# Copy to .env (gitignored) and fill in. `docker compose` reads it automatically.
# Every key here maps to a configuration setting the app already understands.

# --- required -----------------------------------------------------------------
# Sandbox credentials, see paymenttestinfo.txt
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Where VNPAY sends the browser back to. Must be a public https URL, so use the
# tunnel host while testing locally, e.g. https://<id>.ngrok-free.app/api/payment/return
VNPAY_CALLBACK_URL=https://example.ngrok.io/api/payment/return

# --- optional -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# Override when the database is not reachable through the published host port,
# e.g. server=property_mariadb;port=3306;database=ms_identity_test;user=appuser;password=apppass
IDENTITY_TEST_CONNECTION=server=host.docker.internal;port=3306;database=ms_identity_test;user=appuser;password=apppass

VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_VERSION=2.1.0
VNPAY_ORDER_TYPE=other

# Password of the dev-only certificate baked into the image.
DEV_CERT_PASSWORD=paymentdev
