<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true"/>
</head>
<body class="admin-body">
<div class="admin-shell">
    <aside class="admin-sidebar" aria-label="ManagerSpace navigation">
        <div class="admin-brand">
            <span class="admin-brand-mark">M</span>
            <div>
                <strong>ManagerSpace</strong>
                <small>Quản lý mặt bằng</small>
            </div>
        </div>
        <nav class="admin-nav">
            <a class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "is-active" : "")" href="/manager/dashboard">
                <span class="admin-nav-icon">TQ</span><span>Tổng quan</span>
            </a>
            <a class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "AccountList" ? "is-active" : "")" href="/manager/accounts/list" aria-current="page">
                <span class="admin-nav-icon">TK</span><span>Tài khoản</span>
            </a>
            <a class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Statistics" ? "is-active" : "")" href="/manager/statistics">
                <span class="admin-nav-icon">TK</span><span>Thống kê</span>
            </a>
            <a class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Contracts" ? "is-active" : "")" href="/manager/contracts">
                <span class="admin-nav-icon">HD</span><span>Hợp đồng</span>
            </a>
            <a class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Invoices" ? "is-active" : "")" href="/manager/invoices">
                <span class="admin-nav-icon">HD</span><span>Hóa đơn</span>
            </a>
            <a class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Violations" ? "is-active" : "")" href="/manager/violations">
                <span class="admin-nav-icon">VP</span><span>Vi phạm</span>
            </a>
            <a class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Tickets" ? "is-active" : "")" href="/manager/tickets">
                <span class="admin-nav-icon">YC</span><span>Yêu cầu</span>
            </a>
            <a class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Premises" ? "is-active" : "")" href="/manager/premises">
                <span class="admin-nav-icon">MB</span><span>Mặt bằng</span>
            </a>
        </nav>
        <div class="admin-sidebar-footer">
            <span class="admin-avatar">AD</span>
            <div><strong>Admin</strong><small>Administrator</small></div>
        </div>
    </aside>
    <main class="admin-main" role="main">
        @RenderBody()
    </main>
</div>
<partial name="_ManagerModal" />
<script src="~/js/manager/modal.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
