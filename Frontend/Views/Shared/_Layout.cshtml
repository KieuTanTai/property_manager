<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Frontend</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true"/>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @* <link rel="stylesheet" href="~/Frontend.styles.css" asp-append-version="true"/> *@
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/> *@
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Frontend.styles.css" asp-append-version="true"/> *@
</head>
<body class="min-h-screen text-slate-900">
<header
    class="app-header grid grid-cols-[auto_minmax(280px,1fr)_auto] items-center gap-4 border-b border-(--header-border) bg-(--header-surface) px-4 py-3">
    <div class="flex items-center gap-2">
        <button
            id="menu-toggle-btn"
            class="icon-button sidebar-toggle inline-flex h-10 w-10 items-center justify-center rounded-(--radius-button) border border-(--control-border) text-slate-600 transition hover:bg-(--control-hover)"
            type="button" aria-label="toggle sidebar" aria-expanded="false"
            data-sidebar-toggle>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2">
                <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>
        <a class="app-logo text-lg font-semibold text-slate-900 hover:text-sky-600" asp-area="" asp-controller="Home"
           asp-action="Index">Frontend</a>
    </div>

    <div class="mx-auto w-full max-w-xl">
        <form class="app-search relative flex items-center" role="search">
            <svg aria-hidden="true" viewBox="0 0 24 24"
                 class="pointer-events-none absolute left-3 h-4 w-4 fill-none stroke-slate-400 stroke-2">
                <path d="m21 21-4.3-4.3M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z"/>
            </svg>
            <input
                class="h-10 w-full rounded-(--radius-text) border border-(--control-border) pl-9 pr-3 text-sm outline-none ring-(--accent) placeholder:text-slate-400 focus:ring-2"
                type="search" name="q" placeholder="Search" aria-label="Search"/>
        </form>
    </div>

    <div class="header-actions justify-self-end">
        <div class="header-action-group flex items-center gap-2 px-2 py-1">
            <button
                id="cart-btn"
                class="relative inline-flex h-9 items-center gap-2 rounded-(--radius-text) px-3 text-sm font-medium text-slate-700 hover:bg-(--surface)"
                type="button" aria-label="Cart">
                <span>Cart</span>
                <span
                    class="absolute -right-1 -top-1 hidden h-5 min-w-5 rounded-full bg-(--button-danger) px-1 text-center text-xs font-bold leading-5 text-white opacity-80"
                    data-cart-count aria-live="polite">0</span>
            </button>
            <button
                id="history-btn"
                class="inline-flex h-9 items-center gap-2 rounded-(--radius-text) px-3 text-sm font-medium text-slate-700 hover:bg-(--surface)"
                type="button" aria-label="History">
                <span>History</span>
            </button>
            @await Html.PartialAsync("_AccountMenu")
        </div>
    </div>
</header>

<div class="app-shell flex min-h-[calc(100vh-73px)] sidebar-collapsed" data-app-shell>
    <aside class="app-sidebar w-64 border-r border-(--sidebar-border)" aria-label="Sidebar"></aside>

    <div class="app-content flex min-w-0 flex-1 flex-col">
        <main role="main" class="app-main flex-1 p-4">
            @RenderBody()
        </main>
    </div>
</div>

@await Html.PartialAsync("_AuthOverlay")

<footer class="app-footer border-t border-(--footer-border) bg-(--footer-surface) px-4 py-3 text-sm text-slate-600">
    <span>Footer placeholder</span>
</footer>

@* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
@* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
<script type="module" src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
